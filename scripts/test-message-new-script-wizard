#!/usr/bin/env python3
"""PTY integration tests for td message new -i. Requires the script-wizard pod."""

import errno
import os
import pty
import re
import select
import shutil
import signal
import subprocess
import tempfile
import time
from pathlib import Path

SOURCE = Path(__file__).resolve().parent


def run_flow(mode):
    with tempfile.TemporaryDirectory(prefix="wizard-test-") as directory:
        root = Path(directory)
        (root / "scripts").mkdir()
        (root / "tasks/example/nested").mkdir(parents=True)
        shutil.copy2(SOURCE / "td", root / "scripts/td")
        (root / "body.md").write_text("1. From a body file.\n")
        if mode in ("state-change", "same-status", "explicit-subject", "import",
                    "delivered-done-default", "delivered-done-yes"):
            # The latest task message is ready (or delivered), despite a newer
            # answer and a different status in a subtask.
            current_status = ("delivered" if mode.startswith("delivered-done") else "ready")
            for suffix, cargo in (("E", "type: task\n  status: draft"),
                                  ("F", f"type: task\n  status: {current_status}"),
                                  ("G", "type: answer")):
                (root / f"tasks/example/01JMQ3ZK7VR8TQ4XNB0W2G9F6{suffix}.md").write_text(
                    f"---\ncreated: Sun 27 Sep 2006 - 16h 03m 32s\n"
                    f"author: user\nsubject: Existing\ncargo:\n  {cargo}\n---\n")
            (root / "tasks/example/nested/01JMQ3ZK7VR8TQ4XNB0W2G9F6H.md").write_text(
                "---\ncreated: Sun 27 Sep 2006 - 16h 03m 32s\n"
                "author: user\nsubject: Nested\ncargo:\n  type: task\n"
                "  status: delivered\n---\n")
        existing_files = set((root / "tasks/example").rglob("*.md"))
        (root / "import.md").write_text("""---
created: Sun 27 Sep 2006 - 16h 03m 32s
author: user
subject: Imported
cargo:
  type: task
  status: draft
custom: retained
---

# Imported

1. Existing body.
""")
        editor = root / "editor.sh"
        editor.write_text("""#!/bin/sh
printf 'EDITOR_VISIBLE_ON_STDOUT\\n'
printf '%s\\n' "$*" > "$WIZARD_EDITOR_ARGS"
if [ "$WIZARD_MODE" = failure ]; then exit 9; fi
python3 - "$2" "$WIZARD_MODE" <<'PY'
from pathlib import Path
import sys
file = Path(sys.argv[1])
mode = sys.argv[2]
content = file.read_text()
if mode in ('accept', 'decline', 'failure'):
    assert 'subject: Original' in content, content
    assert 'author: user' in content, content
    assert 'status: draft' in content, content
    assert '---\\n\\n# Original\\n\\n\\n' in content, content
    content = content.replace('subject: Original', 'subject: Edited')
    content = content.replace('# Original\\n\\n\\n', '# Edited\\n\\n\\n')
    content = content.replace('---\\n\\n', 'custom: retained\\n---\\n\\n')
    content += '1. Written in the editor.\\n'
elif mode == 'prefill':
    assert 'subject: From flag' in content, content
    assert 'created: Sun 27 Sep 2006 - 16h 03m 32s' in content, content
    assert 'status: draft' in content, content  # ready was changed using the selector
    assert 'harness: pi' in content and 'model: gpt-6-sol' in content, content
    assert 'worker:' in content and 'name: worker-1' in content, content
    assert '1. From a body file.\\n' in content, content
    content = content.replace('subject: From flag', 'subject: From editor')
    content = content.replace('1. From a body file.', '1. Edited body.')
elif mode == 'no-body':
    assert 'status: ready' in content, content
    assert content.endswith('---\\n'), content  # default answer was no
    content = content.replace('subject: No body', 'subject: Metadata edited')
elif mode in ('blocked-default', 'delivered-default', 'draft-no-body'):
    assert f'status: {mode.split("-")[0]}' in content, content
    assert content.endswith('---\\n'), content
elif mode == 'question':
    assert 'type: question' in content and 'Why?\\n' in content, content
    content = content.replace('Why?', 'How?')
elif mode == 'answer':
    assert 'type: answer' in content, content
    assert '01JMQ3ZK7V: Why?' in content, content
    assert '1. Answer from flag.' in content, content
    content = content.replace('1. Answer from flag.', '1. Answer from editor.')
elif mode == 'cancelled':
    assert 'status: cancelled' in content, content
    assert '# Cancelled\\n\\n\\n' in content, content
elif mode == 'import':
    assert 'custom: retained' in content, content
    assert '# Imported' in content, content
    content = content.replace('subject: Imported', 'subject: Edited import')
    content = content.replace('1. Existing body.', '1. Modified import.')
elif mode == 'state-change':
    assert 'subject: ready -> started' in content and 'status: started' in content, content
    assert content.endswith('---\\n'), content
elif mode == 'same-status':
    assert 'subject: Same status' in content and 'status: ready' in content, content
elif mode == 'explicit-subject':
    assert 'subject: Manual subject' in content and 'status: started' in content, content
elif mode.startswith('delivered-done'):
    assert 'subject: delivered -> done' in content and 'status: done' in content, content
    if mode == 'delivered-done-default':
        assert content.endswith('---\\n'), content
    else:
        assert '---\\n\\n# delivered -> done\\n\\n\\n' in content, content
elif mode == 'invalid':
    content = content.replace('status: draft', 'status: invalid')
else:
    raise AssertionError(mode)
file.write_text(content)
PY
""")
        editor.chmod(0o755)
        env = os.environ.copy()
        env.update(EDITOR=f"sh {editor} --test-flag", WIZARD_EDITOR_ARGS=str(root / "editor-args"),
                   WIZARD_MODE=mode, TERM="xterm-256color")

        cmd = [str(root / "scripts/td"), "message", "new", "-i"]
        if mode == "prefill":
            cmd += ["--task", "example", "--subject", "From flag", "--type", "task",
                    "--status", "ready", "--author", "agent", "--harness", "pi",
                    "--model", "gpt-6-sol", "--worker", "agent",
                    "--worker-model", "gpt-6-sol", "--worker-name", "worker-1",
                    "--created", "Sun 27 Sep 2006 - 16h 03m 32s", "--body-file", "body.md"]
        elif mode == "no-body":
            cmd += ["--task", "example", "--subject", "No body", "--type", "task",
                    "--status", "ready"]
        elif mode in ("blocked-default", "delivered-default", "draft-no-body"):
            cmd += ["--task", "example", "--subject", "No body", "--type", "task",
                    "--status", mode.split("-")[0]]
        elif mode == "question":
            cmd += ["--task", "example", "--subject", "Why?", "--type", "question",
                    "--body", "Why?"]
        elif mode == "answer":
            cmd += ["--task", "example", "--subject", "Answer", "--type", "answer",
                    "--regarding", "01JMQ3ZK7V=Why?", "--body", "1. Answer from flag."]
        elif mode == "cancelled":
            cmd += ["--task", "example", "--subject", "Cancelled", "--type", "task",
                    "--status", "cancelled"]
        elif mode == "import":
            cmd += ["--task", "example", "--file", "import.md"]
        elif mode == "invalid":
            cmd += ["--task", "example", "--subject", "Original", "--type", "task",
                    "--status", "draft"]
        elif mode in ("state-change", "same-status", "explicit-subject",
                      "delivered-done-default", "delivered-done-yes"):
            status = ("done" if mode.startswith("delivered-done") else
                      "ready" if mode == "same-status" else "started")
            cmd += ["--task", "example", "--type", "task", "--status", status]
            if mode == "explicit-subject":
                cmd += ["--subject", "Manual subject"]

        pid, master = pty.fork()
        if pid == 0:
            os.chdir(root)
            os.execve(cmd[0], cmd, env)

        output = b""
        deadline = time.monotonic() + 40
        child = 0
        draft = None

        def read_more():
            nonlocal output
            if time.monotonic() > deadline:
                raise AssertionError(f"Wizard timed out: {output[-2000:]!r}")
            ready, _, _ = select.select([master], [], [], 0.2)
            if ready:
                try:
                    output += os.read(master, 65536)
                except OSError as error:
                    if error.errno != errno.EIO:  # PTY closed by child
                        raise

        def wait_for(text):
            nonlocal output
            needle = text.encode()
            while needle not in output:
                read_more()
            output = output[output.index(needle) + len(needle):]

        try:
            wait_for("Task folder (type to filter)")
            os.write(master, b"\x1b[B\r" if mode == "prefill" else b"\r")
            wait_for("Message type")
            os.write(master, b"\r")
            if mode not in ("question", "answer"):
                wait_for("Status")
                os.write(master, b"\x1b[A\r" if mode == "prefill" else b"\r")
            wait_for("Subject (max 64 characters)")
            if mode in ("accept", "decline", "failure"):
                os.write(master, b"Original\r")
            elif mode == "same-status":
                os.write(master, b"\r")
                # The pod keeps asking when no default is available.
                wait_for("Subject (max 64 characters)")
                os.write(master, b"Same status\r")
            else:
                os.write(master, b"\r")
            wait_for("Enter a body message?")
            os.write(master, b"y\r" if mode == "delivered-done-yes" else
                     b"n\r" if mode == "draft-no-body" else b"\r")
            wait_for("Editing message in ")
            while b".md" not in output:
                read_more()
            draft = Path(output.split(b".md", 1)[0].decode() + ".md")
            wait_for("EDITOR_VISIBLE_ON_STDOUT")
            if mode == "failure":
                wait_for("Editor exited with status 9")
                assert b"Create this message?" not in output
            else:
                wait_for("Create this message?")
                assert set((root / "tasks/example").rglob("*.md")) == existing_files
                os.write(master, b"n\r" if mode == "decline" else b"\r")

            assert "--test-flag" in (root / "editor-args").read_text()
            while True:
                child, status = os.waitpid(pid, os.WNOHANG)
                if child:
                    break
                read_more()
            expected_exit = 1 if mode in ("failure", "invalid") else 0
            assert os.waitstatus_to_exitcode(status) == expected_exit, output[-2000:]
            files = set((root / "tasks/example").rglob("*.md")) - existing_files
            if mode in ("decline", "failure", "invalid"):
                assert not files, files
            else:
                assert len(files) == 1, files
                file = files.pop()
                content = file.read_text()
                assert re.search(
                    r"^created: [A-Z][a-z]{2} \d{2} [A-Z][a-z]{2} \d{4} - \d{2}h \d{2}m \d{2}s$",
                    content, re.MULTILINE), content
                if mode == "accept":
                    assert "subject: Edited\n" in content, content
                    assert "custom: retained\n---\n\n# Edited\n\n\n1. Written in the editor.\n" in content, content
                if mode == "prefill":
                    assert file.parent.name == "nested", file
                    assert "subject: From editor" in content and "status: draft" in content, content
                    assert "1. Edited body." in content, content
                if mode == "no-body":
                    assert "subject: Metadata edited" in content and content.endswith("---\n"), content
                if mode == "question":
                    assert "How?" in content and "Why?\n" not in content, content
                if mode == "answer":
                    assert "1. Answer from editor." in content, content
                if mode == "import":
                    assert "custom: retained" in content and "1. Modified import." in content, content
                if mode == "state-change":
                    assert "subject: ready -> started\n" in content, content
                if mode == "same-status":
                    assert "subject: Same status\n" in content, content
                if mode == "explicit-subject":
                    assert "subject: Manual subject\n" in content, content
                if mode.startswith("delivered-done"):
                    assert "subject: delivered -> done\n" in content, content
                assert subprocess.run(["./scripts/td", "message", "validate"], cwd=root,
                                      stdout=subprocess.DEVNULL, check=False).returncode == 0
            assert draft.exists() == (mode in ("failure", "invalid")), draft
            if mode == "invalid":
                assert b"cargo.status: must be one of" in output, output[-2000:]
        finally:
            if draft is not None:
                draft.unlink(missing_ok=True)
            if not child:
                try:
                    os.kill(pid, signal.SIGKILL)
                    os.waitpid(pid, 0)
                except ProcessLookupError:
                    pass
            os.close(master)


for mode in ("accept", "decline", "failure", "prefill", "no-body", "question",
             "answer", "cancelled", "import", "invalid", "state-change",
             "same-status", "explicit-subject", "delivered-done-default",
             "delivered-done-yes", "blocked-default", "delivered-default",
             "draft-no-body"):
    run_flow(mode)
print("td interactive editor tests passed")
