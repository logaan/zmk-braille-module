#!/bin/sh
# Compatibility launcher for the standalone TaskDown terminal UI.
# Preserve the caller's working directory and pass through any vault argument.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
taskdown_home=${TASKDOWN_HOME:-"$script_dir/../../../../babashka/taskdown"}
if [ ! -x "$taskdown_home/task-down" ]; then
    printf '%s\n' "TaskDown not found at $taskdown_home. Set TASKDOWN_HOME to its checkout." >&2
    exit 1
fi
exec "$taskdown_home/task-down" "$@"
