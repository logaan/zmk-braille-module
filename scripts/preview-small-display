#!/usr/bin/env python3
"""Render actual LVGL8 small-screen pages; no firmware or hardware is changed."""
from pathlib import Path
import argparse
import os
import shlex
import struct
import subprocess
import tempfile
import zlib
root=Path(__file__).resolve().parents[1]
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--lvgl',type=Path,default=root/'build/baseline/modules/lib/gui/lvgl')
p.add_argument('--output',type=Path,default=root/'build/previews/small-display.png')
a=p.parse_args()
if '#define LVGL_VERSION_MAJOR 8' not in (a.lvgl/'lvgl.h').read_text():p.error('Use the pinned LVGL8 baseline')
with tempfile.TemporaryDirectory() as tmp:
 tmp=Path(tmp)
 (tmp/'lv_conf.h').write_text('''#ifndef LV_CONF_H
#define LV_CONF_H
#define LV_COLOR_DEPTH 1
#define LV_MEM_CUSTOM 1
#define LV_USE_LOG 0
#define LV_USE_CANVAS 1
#define LV_USE_IMG 1
#define LV_USE_LABEL 1
#define LV_FONT_UNSCII_8 1
#define LV_FONT_MONTSERRAT_14 0
#define LV_FONT_DEFAULT &lv_font_unscii_8
#endif
''')
 cmd=shlex.split(os.environ.get('CC','cc'))+['-O1','-w','-DCONFIG_ZMK_BRAILLE_WIDGET=1','-DLV_CONF_PATH=lv_conf.h',
  '-I',str(tmp),'-I',str(a.lvgl),'-I',str(root/'include'),'-I',str(root/'tests/host/stubs'),
  str(root/'tests/host/preview_small_screen.c'),str(root/'src/braille_small_screen.c'),str(root/'src/braille_small_canvas.c'),
  *map(str,a.lvgl.glob('src/**/*.c')),'-lm','-o',str(tmp/'preview')]
 subprocess.run(cmd,check=True)
 subprocess.run([str(tmp/'preview'),str(tmp/'preview.ppm')],check=True)
 _,dim,_,data=(tmp/'preview.ppm').read_bytes().split(b'\n',3);w,h=map(int,dim.split());scale=4;rows=[]
 for y in range(h):
  row=b''.join(data[(y*w+x)*3:(y*w+x+1)*3]*scale for x in range(w));rows.extend([b'\0'+row]*scale)
 def chunk(t,d):return struct.pack('>I',len(d))+t+d+struct.pack('>I',zlib.crc32(t+d))
 a.output.parent.mkdir(parents=True,exist_ok=True)
 a.output.write_bytes(b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',w*scale,h*scale,8,2,0,0,0))+chunk(b'IDAT',zlib.compress(b''.join(rows)))+chunk(b'IEND',b''))
 print(a.output)
