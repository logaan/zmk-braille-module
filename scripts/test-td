#!/usr/bin/env bash
# Integration smoke tests for the TaskDown CLI. Run from any directory.
set -euo pipefail

td="$(cd "$(dirname "$0")" && pwd)/td"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
mkdir -p tasks/example/nested
printf 'From a file?\n' > body.md

fail_if_successful() {
  if "$@" > output.txt 2>&1; then
    printf 'Expected failure from: %s\n' "$*" >&2
    exit 1
  fi
  if grep -q '^----- Error' output.txt; then
    printf 'Unexpected exception from: %s\n' "$*" >&2
    exit 1
  fi
}

"$td" > /dev/null
"$td" --help > /dev/null
"$td" message > /dev/null
"$td" message --help > /dev/null
"$td" message new --help > /dev/null
"$td" message validate --help > /dev/null
"$td" system > system.txt
grep -Fq 'A brief summary of the message, not the task as a whole.' system.txt
grep -Fq '`OldStatus -> NewStatus`' system.txt
grep -Fq 'subject: draft -> ready' system.txt
"$td" system --help > /dev/null

task=$("$td" message new --task example/nested --subject 'Work' --type task \
  --status ready --author agent --harness pi --model kimi-k3 \
  --worker agent --worker-model kimi-k3 \
  --created 'Sun 27 Sep 2006 - 16h 03m 32s')
grep -q '^created: Sun 27 Sep 2006 - 16h 03m 32s$' "$task"
question=$("$td" message new --task example --subject 'Question' --type question \
  --body-file body.md)
answer=$("$td" message new --task example --subject 'Answer' --type answer \
  --regarding '01JMQ3ZK7V=First' --regarding '01JMQ4B2XD=Second')
cat > draft.md <<'EOF'
---
created: Sun 29 Feb 2004 - 23h 59m 59s
author: user
subject: Edited in a full message file
cargo:
  type: task
  status: draft
  custom: preserved
---

# An edited message

1. Keep the frontmatter and body exactly as written.
EOF
imported=$("$td" message new --task example/nested --file draft.md)
cmp draft.md "$imported"

"$td" message validate > /dev/null
"$td" message validate "$(basename "$task" .md)" > /dev/null
"$td" message validate "$(basename "$question")" > /dev/null
"$td" message validate "$(basename "$answer" .md)" > /dev/null
"$td" message validate "$(basename "$imported" .md)" > /dev/null
# Dates generated without --created include the year and seconds.
grep -Eq '^created: [A-Z][a-z]{2} [0-9]{2} [A-Z][a-z]{2} [0-9]{4} - [0-9]{2}h [0-9]{2}m [0-9]{2}s$' "$question"

fail_if_successful "$td" message new --task example --subject --type task --status ready
fail_if_successful "$td" message new --task example --subject X --type answer --unknown value
fail_if_successful "$td" message new --task example --subject X --type answer extra
fail_if_successful "$td" message new --task example --subject X --type task
fail_if_successful "$td" message new --task example --subject X --type task --status ready --author agent
fail_if_successful "$td" message new --task example --subject X --type answer --status ready
fail_if_successful "$td" message new --task example --subject X --type answer --regarding invalid
fail_if_successful "$td" message new --task example --subject X --type question --body 'No question'
fail_if_successful "$td" message new --task example --file draft.md --subject 'Ignored'
fail_if_successful "$td" message new --task example --file missing.md
fail_if_successful "$td" message new --task example --subject X --type task \
  --status draft --body-file missing.md
grep -Fq 'body file not found: missing.md' output.txt
fail_if_successful "$td" message new --task example --subject X --type task \
  --status draft --body-file tasks/example
grep -Fq 'Cannot create message:' output.txt
grep -Fq 'body file is not a regular file: tasks/example' output.txt
printf 'Not readable\n' > unreadable.md
chmod 000 unreadable.md
# Root can read mode-000 files; exercise the read-failure path when permissions apply.
if [[ ! -r unreadable.md ]]; then
  fail_if_successful "$td" message new --task example --subject X --type task \
    --status draft --body-file unreadable.md
  grep -Fq 'Cannot create message:' output.txt
  grep -Fq 'cannot read body file: unreadable.md' output.txt
fi
chmod 600 unreadable.md
printf 'invalid YAML: [\n' > invalid.md
fail_if_successful "$td" message new --task example --file invalid.md
printf '%s\n' '---' 'created: Sun 27 Sep 2006 - 13h 23m 00s' 'author: user' \
  'subject: Invalid question' 'cargo:' '  type: question' '---' \
  '' 'No question mark' > invalid.md
fail_if_successful "$td" message new --task example --file invalid.md
[[ $(find tasks -name '*.md' | wc -l | tr -d ' ') == 4 ]]

# Invalid calendar dates, time ranges and shapes fail through every entry point.
for created in \
  'Sun 99 Sep 2006 - 99h 99m 99s' \
  'Sun 31 Apr 2006 - 16h 03m 32s' \
  'Sun 29 Feb 2006 - 16h 03m 32s' \
  'Sun 00 Sep 2006 - 16h 03m 32s' \
  'Sun 27 Sep 0000 - 16h 03m 32s' \
  'Sun 27 Sep 2006 - 24h 03m 32s' \
  'Sun 27 Sep 2006 - 16h 60m 32s' \
  'Sun 27 Sep 2006 - 16h 03m 60s' \
  'Foo 27 Sep 2006 - 16h 03m 32s' \
  'Sun 27 Sep 13h23' \
  'Sun 27 Sep 2006 - 16h 03m 32'; do
  fail_if_successful "$td" message new --task example --subject Bad --type task \
    --status draft --created "$created"
  grep -q 'created: must be a valid datetime' output.txt
  printf '%s\n' '---' "created: $created" 'author: user' \
    'subject: Bad' 'cargo:' '  type: task' '  status: draft' '---' \
    > tasks/example/01JMQ3ZK7VR8TQ4XNB0W2G9F6E.md
  fail_if_successful "$td" message validate 01JMQ3ZK7VR8TQ4XNB0W2G9F6E
  grep -q 'created: must be a valid datetime' output.txt
  cp tasks/example/01JMQ3ZK7VR8TQ4XNB0W2G9F6E.md invalid.md
  fail_if_successful "$td" message new --task example --file invalid.md
  grep -q 'created: must be a valid datetime' output.txt
done
rm tasks/example/01JMQ3ZK7VR8TQ4XNB0W2G9F6E.md
[[ $(find tasks -name '*.md' | wc -l | tr -d ' ') == 4 ]]
fail_if_successful "$td" message validate unknown
fail_if_successful "$td" message validate abc def

# A 128-bit ULID's first digit is 0-7, including for truncated answer ids.
base_id=01JMQ3ZK7VR8TQ4XNB0W2G9F6E
for first in 0 7 8 Z; do
  id="${first}${base_id:1}"
  cp draft.md "tasks/example/$id.md"
  if [[ $first == 0 || $first == 7 ]]; then
    "$td" message validate "$id" > /dev/null
  else
    fail_if_successful "$td" message validate "$id"
    grep -Fq 'file name: must be a ULID' output.txt
  fi
  rm "tasks/example/$id.md"
done
valid_regarding=$("$td" message new --task example --subject Boundary --type answer \
  --regarding '71JMQ3ZK7V=Boundary')
"$td" message validate "$(basename "$valid_regarding" .md)" > /dev/null
rm "$valid_regarding"
for first in 8 Z; do
  fail_if_successful "$td" message new --task example --subject Bad --type answer \
    --regarding "${first}1JMQ3ZK7V=Invalid"
  grep -Fq 'cargo.regarding: key must be a 10 char truncated task id' output.txt
done
[[ $(find tasks -name '*.md' | wc -l | tr -d ' ') == 4 ]]

# Creation and file validation must apply the same message rules.
printf '%s\n' '---' 'created: Sun 27 Sep 2006 - 13h 23m 00s' 'author: user' \
  'subject: Work' 'cargo:' '  type: task' '  status: invalid' '---' \
  > tasks/example/01JMQ3ZK7VR8TQ4XNB0W2G9F6E.md
fail_if_successful "$td" message validate 01JMQ3ZK7VR8TQ4XNB0W2G9F6E
printf 'td smoke tests passed\n'
