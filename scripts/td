#!/usr/bin/env bb
;;
;; td - TaskDown command line tool.
;;
;; Implements the TaskDown system:
;;   td system                 - print the built-in system reference
;;   td message validate [id]  - check message file(s) against the spec
;;   td message new            - create a new message inside an existing task
;;

(require '[babashka.cli :as cli]
         '[babashka.fs :as fs]
         '[clj-yaml.core :as yaml]
         '[clojure.string :as str])

(import '[java.time LocalDateTime ZonedDateTime]
        '[java.time.format DateTimeFormatterBuilder DateTimeParseException ResolverStyle]
        '[java.time.temporal ChronoField]
        '[java.util HashSet Locale])

;; ---------------------------------------------------------------------------
;; Spec constants

(def statuses
  #{"draft" "ready" "started" "blocked" "delivered" "done" "cancelled"})

(def cargo-types #{"task" "question" "answer"})

(def message-filename-re
  "128-bit ULID: first digit 0-7, then 25 Crockford base32 chars, followed by .md."
  #"^[0-7][0-9A-HJKMNP-TV-Z]{25}\.md$")

(def truncated-ulid-re
  "A task ULID truncated to 10 chars, used in answer 'regarding' keys."
  #"^[0-7][0-9A-HJKMNP-TV-Z]{9}$")

(def agent-str-re
  "Agent harness/model/name values."
  #"^[a-z0-9./-]+$")

(def max-subject-length 64)

;; ---------------------------------------------------------------------------
;; Small utilities

(defn die
  "Print a message to stderr and exit non-zero."
  [& parts]
  (binding [*out* *err*]
    (apply println parts))
  (System/exit 1))

(def crockford "0123456789ABCDEFGHJKMNPQRSTVWXYZ")

(defn- encode32
  "Encode non-negative integer n as len Crockford base32 chars."
  [n len]
  (loop [n n, acc (list)]
    (let [acc (conj acc (nth crockford (int (mod n 32))))]
      (if (>= (count acc) len)
        (apply str acc)
        (recur (quot n 32) acc)))))

(defn gen-ulid
  "Generate a ULID: 48-bit ms timestamp + 80 bits of secure randomness."
  []
  (let [random-bytes (byte-array 10)]
    (.nextBytes (java.security.SecureRandom.) random-bytes)
    (str (encode32 (System/currentTimeMillis) 10)
         (encode32 (BigInteger. 1 random-bytes) 16))))

(def created-formatter
  (-> (DateTimeFormatterBuilder.)
      (.appendPattern "EEE dd MMM yyyy' - 'HH'h' mm'm' ss's'")
      (.parseDefaulting ChronoField/ERA 1)
      (.toFormatter Locale/ENGLISH)
      (.withResolverStyle ResolverStyle/STRICT)
      ;; Legacy messages keep their original weekday when backfilled with 2006.
      ;; Parse the weekday name, but resolve only the calendar date and time.
      (.withResolverFields (HashSet. [ChronoField/ERA ChronoField/YEAR_OF_ERA
                                      ChronoField/MONTH_OF_YEAR ChronoField/DAY_OF_MONTH
                                      ChronoField/HOUR_OF_DAY ChronoField/MINUTE_OF_HOUR
                                      ChronoField/SECOND_OF_MINUTE]))))

(defn valid-created? [value]
  (and (string? value)
       (try
         (LocalDateTime/parse value created-formatter)
         true
         (catch DateTimeParseException _ false))))

(defn now-created []
  (.format (ZonedDateTime/now) created-formatter))

;; ---------------------------------------------------------------------------
;; Message discovery and parsing

(defn message-files
  "All message files: .md files inside task folders (any depth under tasks/),
  excluding loose .md files at the tasks/ root such as taskdown.md."
  []
  (->> (fs/glob "tasks" "**.md")
       (filter (fn [f]
                 (> (count (fs/components (fs/relativize "tasks" f))) 1)))
       (sort-by str)))

(defn find-message
  "Find a single message file by ULID, ULID without .md, or unique prefix."
  [id]
  (let [id (str/replace id #"\.md$" "")
        files (message-files)
        exact (filter #(= (str (fs/file-name %)) (str id ".md")) files)
        matches (if (seq exact)
                  exact
                  (filter #(str/starts-with? (str (fs/file-name %)) id) files))]
    (cond
      (empty? matches)
      {:error (str "No message found with id: " id)}

      (> (count matches) 1)
      {:error (str "Id prefix matches multiple messages:\n"
                   (str/join "\n" (map #(str "  " %) matches)))}

      :else
      {:file (first matches)})))

(defn parse-message-file
  "Returns {:frontmatter map :body string} or {:error string}."
  [path]
  (let [content (slurp (str path))]
    (if-let [[_ fm body] (re-matches #"(?s)---\r?\n(.*?)\r?\n---\r?\n?(.*)" content)]
      (let [parsed (try (yaml/parse-string fm)
                        (catch Exception _ ::yaml-error))]
        (if (= parsed ::yaml-error)
          {:error "frontmatter is not valid YAML"}
          {:frontmatter parsed :body body}))
      {:error "missing YAML frontmatter (file must start with ---)"})))

;; ---------------------------------------------------------------------------
;; Message validation (spec section 3)

(defn check-contributor [v label problem!]
  (cond
    (string? v)
    (when-not (= v "user")
      (problem! (str label ": must be 'user' or an agent map, got: " (pr-str v))))

    (map? v)
    (do
      (when-not (= "agent" (:type v))
        (problem! (str label ": type must be \"agent\"")))
      (cond
        (nil? (:model v))
        (problem! (str label ": model is required for an agent"))

        (not (and (string? (:model v)) (re-matches agent-str-re (:model v))))
        (problem! (str label ": model must match " agent-str-re ", got: " (pr-str (:model v)))))
      (doseq [k [:harness :name]]
        (when (contains? v k)
          (let [x (get v k)]
            (when-not (and (string? x) (re-matches agent-str-re x))
              (problem! (str label ": " (name k) " must match " agent-str-re
                             ", got: " (pr-str x))))))))

    :else
    (problem! (str label ": must be 'user' or an agent map"))))

(defn check-cargo [frontmatter body problem!]
  (let [cargo (:cargo frontmatter)]
    (cond
      (nil? cargo)
      (problem! "cargo: is required")

      (not (map? cargo))
      (problem! "cargo: must be a map")

      :else
      (let [type (:type cargo)]
        (cond
          (nil? type)
          (problem! "cargo.type: is required (task, question, or answer)")

          (not (contains? cargo-types type))
          (problem! (str "cargo.type: must be one of task, question, answer, got: "
                         (pr-str type)))

          (= type "task")
          (do
            (cond
              (nil? (:status cargo))
              (problem! "cargo.status: is required for a task")

              (not (contains? statuses (:status cargo)))
              (problem! (str "cargo.status: must be one of " (str/join ", " (sort statuses))
                             ", got: " (pr-str (:status cargo)))))
            (when (contains? cargo :worker)
              (check-contributor (:worker cargo) "cargo.worker" problem!)))

          (= type "question")
          (let [n (count (re-seq #"\?" (or body "")))]
            (when-not (= 1 n)
              (problem! (str "question: body must ask just one question (found "
                             n " question marks)"))))

          (= type "answer")
          (when (contains? cargo :regarding)
            (let [regarding (:regarding cargo)]
              (if-not (map? regarding)
                (problem! "cargo.regarding: must be a map of truncated task id -> subject")
                (doseq [[k v] regarding]
                  (let [k (if (keyword? k) (name k) (str k))]
                    (when-not (re-matches truncated-ulid-re k)
                      (problem! (str "cargo.regarding: key must be a 10 char truncated task id, got: "
                                     (pr-str k))))
                    (when-not (and (string? v) (<= (count v) max-subject-length))
                      (problem! (str "cargo.regarding " k ": subject must be a string of "
                                     max-subject-length " characters or less")))))))))))))

(defn validate-message-data
  "Validate parsed or prospective message data. Returns a vector of problems."
  [frontmatter body]
  (let [problems (atom [])
        problem! (fn [msg] (swap! problems conj msg))]
    (if-not (map? frontmatter)
      (problem! "frontmatter: must be a YAML map")
      (do
        (cond
          (nil? (:created frontmatter))
          (problem! "created: is required")

          (not (valid-created? (:created frontmatter)))
          (problem! (str "created: must be a valid datetime in the format 'Sun 27 Sep 2006 - 16h 03m 32s', got: "
                         (pr-str (:created frontmatter)))))
        (if (nil? (:author frontmatter))
          (problem! "author: is required")
          (check-contributor (:author frontmatter) "author" problem!))
        (cond
          (nil? (:subject frontmatter))
          (problem! "subject: is required")

          (not (and (string? (:subject frontmatter))
                    (<= (count (:subject frontmatter)) max-subject-length)))
          (problem! (str "subject: must be a string of " max-subject-length
                         " characters or less")))
        (check-cargo frontmatter body problem!)))
    @problems))

(defn validate-message
  "Returns a vector of problem strings (empty when valid)."
  [path]
  (let [fname (str (fs/file-name path))
        filename-problems (if (re-matches message-filename-re fname)
                            []
                            [(str "file name: must be a ULID (26 Crockford base32 chars, first 0-7, then .md), got: " fname)])
        {:keys [frontmatter body error]} (parse-message-file path)]
    (into filename-problems
          (if error [error] (validate-message-data frontmatter body)))))

;; ---------------------------------------------------------------------------
;; Message creation (spec sections 3, 3.1, 3.2)

(def new-option-spec
  [[:task           {:coerce :string :desc "Existing task folder (required)"}]
   [:subject        {:coerce :string :desc (str "Message subject, max " max-subject-length
                                                " characters (required)")}]
   [:type           {:coerce :string :desc "Cargo type: task, question, or answer (required)"}]
   [:status         {:coerce :string :desc "Task status (required for a task)"}]
   [:worker         {:coerce :string :desc "Task worker: user or agent"}]
   [:worker-harness {:coerce :string :desc "Worker agent harness"}]
   [:worker-model   {:coerce :string :desc "Worker agent model (required for an agent)"}]
   [:worker-name    {:coerce :string :desc "Worker agent name"}]
   [:regarding      {:coerce [:string] :desc "Answer reference: TASKID10=subject (repeatable)"}]
   [:author         {:coerce :string :desc "Message author: user or agent (default: user)"}]
   [:harness        {:coerce :string :desc "Author agent harness"}]
   [:model          {:coerce :string :desc "Author agent model (required for an agent)"}]
   [:name           {:coerce :string :desc "Author agent name"}]
   [:body           {:coerce :string :desc "Markdown body"}]
   [:body-file      {:coerce :string :desc "Read markdown body from a file"}]
   [:file           {:coerce :string :desc "Import a complete Markdown message verbatim (only with --task)"}]
   [:created        {:coerce :string :desc "Creation datetime: Sun 27 Sep 2006 - 16h 03m 32s (default: now)"}]])

(defn resolve-task-dir
  "Resolves --task to an existing directory under tasks/."
  [task]
  (let [task (some-> task (str/replace #"^tasks/" "") (str/replace #"/+$" ""))]
    (cond
      (str/blank? task)
      {:error "a task folder is required (--task <folder>), eg: --task 02-td-script"}

      (some #{".." "."} (str/split task #"/"))
      {:error (str "task folder must be a plain path inside tasks/, got: " task)}

      :else
      (let [dir (fs/path "tasks" task)]
        (if (fs/directory? dir)
          {:dir dir :name task}
          {:error (str "task folder not found: tasks/" task)})))))

(defn contributor-value
  "Build a contributor from CLI parts; leave invalid values for validation."
  [who {:keys [harness model name]}]
  (if (= who "agent")
    (cond-> (array-map :type "agent")
      harness (assoc :harness harness)
      model   (assoc :model model)
      name    (assoc :name name))
    who))

(defn run-new-file [{:keys [task file] :as opts}]
  (let [task-result (when task (resolve-task-dir task))
        extra-flags (sort (remove #{:task :file} (keys opts)))
        {:keys [frontmatter body error]}
        (when (fs/regular-file? file) (parse-message-file file))
        problems (cond-> []
                   (nil? task) (conj "missing required flag: --task <folder>")
                   (:error task-result) (conj (:error task-result))
                   (seq extra-flags) (conj (str "--file may only be used with --task (also got: "
                                                (str/join ", " (map #(str "--" (name %)) extra-flags)) ")"))
                   (not (fs/regular-file? file)) (conj (str "message file not found: " file))
                   error (conj error)
                   (and frontmatter (not error)) (into (validate-message-data frontmatter body)))]
    (if (seq problems)
      (do (binding [*out* *err*]
            (println "Cannot create message:")
            (doseq [e problems] (println " " "-" e))
            (println "See 'td message new --help'."))
          (System/exit 1))
      (let [id (gen-ulid)
            target (fs/path (:dir task-result) (str id ".md"))]
        ;; Keep the edited YAML, body, and formatting exactly as they were.
        (fs/copy file target)
        (println (str "tasks/" (:name task-result) "/" id ".md"))))))

(defn read-body-file
  "Read a regular body file, reporting path and read failures as CLI errors."
  [path]
  (try
    (cond
      (not (fs/exists? path))
      {:error (str "body file not found: " path)}

      (not (fs/regular-file? path))
      {:error (str "body file is not a regular file: " path)}

      :else
      {:body (slurp path)})
    (catch Exception e
      {:error (str "cannot read body file: " path " (" (.getMessage e) ")")})))

(defn run-new-flags [{:keys [opts]}]
  (let [{:keys [task created author harness model subject type status
                worker worker-harness worker-model worker-name regarding
                body body-file]
         agent-name :name} opts
        author (or author "user")
        errors (atom [])
        err! (fn [msg] (swap! errors conj msg))
        task-result (when task (resolve-task-dir task))]
    ;; These constraints concern CLI flag combinations, not message data.
    (cond
      (nil? task) (err! "missing required flag: --task <folder>")
      (:error task-result) (err! (:error task-result)))
    (when (not= author "agent")
      (doseq [flag [:harness :model :name]
              :when (contains? opts flag)]
        (err! (str "--" (name flag) " requires --author agent"))))
    (when (and status (not= type "task"))
      (err! "--status only applies when --type task"))
    (when (and worker (not= type "task"))
      (err! "--worker only applies when --type task"))
    (when (not= worker "agent")
      (doseq [flag [:worker-harness :worker-model :worker-name]
              :when (contains? opts flag)]
        (err! (str "--" (name flag) " requires --worker agent"))))
    (when (and (seq regarding) (not= type "answer"))
      (err! "--regarding only applies when --type answer"))
    (when (and body body-file)
      (err! "use only one of --body and --body-file"))
    (let [body-file-result (when body-file (read-body-file body-file))
          regarding-entries (into [] (keep (fn [r]
                                             (let [[k v] (str/split r #"=" 2)]
                                               (if (or (nil? v) (str/blank? k))
                                                 (do (err! (str "--regarding must be <TASKID10>=<subject>, got: "
                                                                (pr-str r)))
                                                     nil)
                                                 [k v]))))
                                  regarding)
          body-text (or body (:body body-file-result))
          frontmatter (array-map
                       :created (or created (now-created))
                       :author (contributor-value author {:harness harness
                                                          :model model
                                                          :name agent-name})
                       :subject subject
                       :cargo (cond-> (array-map :type type)
                                (= type "task")
                                (assoc :status status)
                                (and (= type "task") worker)
                                (assoc :worker (contributor-value
                                                worker {:harness worker-harness
                                                        :model worker-model
                                                        :name worker-name}))
                                (and (= type "answer") (seq regarding))
                                (assoc :regarding (into (array-map) regarding-entries))))
          problems (into (cond-> @errors
                           (:error body-file-result) (conj (:error body-file-result)))
                         (validate-message-data frontmatter body-text))]
      (if (seq problems)
        (do (binding [*out* *err*]
              (println "Cannot create message:")
              (doseq [e problems] (println " " "-" e))
              (println "See 'td message new --help'."))
            (System/exit 1))
        (let [id (gen-ulid)
              file (fs/path (:dir task-result) (str id ".md"))
              content (str "---\n"
                           (yaml/generate-string frontmatter
                                                 :dumper-options {:flow-style :block})
                           "---\n"
                           (when-not (str/blank? body-text)
                             (str "\n" (str/trim body-text) "\n")))]
          (spit (str file) content)
          (println (str "tasks/" (:name task-result) "/" id ".md")))))))

(defn run-new [{:keys [opts] :as command}]
  (if (contains? opts :file)
    (run-new-file opts)
    (run-new-flags command)))

;; ---------------------------------------------------------------------------
;; Validate command

(defn run-validate [{:keys [args]}]
  (let [args (or args [])]
    (when (> (count args) 1)
      (die "td message validate takes at most one message id."))
    (let [files (if-let [id (first args)]
                  (let [{:keys [file error]} (find-message id)]
                    (if error (die error) [file]))
                  (message-files))]
      (if (empty? files)
        (die "No message files found.")
        (let [results (map (fn [f] {:file f :problems (validate-message f)}) files)
              invalid (filter #(seq (:problems %)) results)]
          (doseq [{:keys [file problems]} results]
            (if (empty? problems)
              (println "OK     " (str file))
              (do (println "INVALID" (str file))
                  (doseq [p problems] (println " " "-" p)))))
          (println (str (count results) " message(s) checked, "
                        (count invalid) " invalid."))
          (System/exit (if (seq invalid) 1 0)))))))

;; ---------------------------------------------------------------------------
;; Command help beyond the option descriptions in new-option-spec

(def new-help-epilog
  (str "Task statuses: " (str/join ", " (sort statuses)) "\n"
       "Questions must have a body with one question mark.\n\n"
       "Examples:\n"
       "  td message new --task 02-td-script --subject 'draft -> ready' \\\n"
       "      --type task --status ready\n"
       "  td message new --task 02-td-script --subject 'Which clock?' \\\n"
       "      --type question --body 'Should we pin the clock in tests?'\n"
       "  td message new --task 02-td-script --file /tmp/edited-message.md"))

(def validate-help-epilog
  "The optional id is a ULID (with or without .md) or a unique prefix.
Without an id, every message under tasks/ is checked.
Exit status: 0 when valid, 1 otherwise.")

;; ---------------------------------------------------------------------------
;; Built-in system reference
;;
;; Keep this in the executable so `td system` works without project files.

(def system-description
  "td system - TaskDown system reference

USAGE:
  td system

The TaskDown system reference is built into td; no project file is required.

# TaskDown

1.  This project uses the TaskDown system for managing work.
2.  This system defined tasks in plain text and uses them as the primary means
    of communication between users and agents.

## 1. Tasks folder

1.  A folder containing task folders.

## 2. Task folder

1.  A task has a number and a name. (eg: \"01\", \"keyboard-keys\")
2.  This corresponds to a folder. (eg: \"tasks/01-keyboard-keys/\")
3.  Task folders may contain other task folders.
    1.  These are subtasks that will be completed as part of the parent task.
    2.  Numbers on subtasks should start from `01` and be unique within a task.
    3.  A large project could use subtasks to break work down into phases,
        containing milestones, containing individual steps.
    4.  But often tasks are small and have no need for subtasks.

## 3. Message file

1.  A task folder contains message files.
2.  Each message file
    1.  Has an ID
        1.  This is a ULID.
    2.  Is a markdown file.
        1.  The file name format is \"id.md\"
        2.  Eg: \"01JMQ3ZK7VR8TQ4XNB0W2G9F6E.md\"
    3.  Will contain YAML frontmatter
        1.  Described in `3.1. Message root properties`
    4.  May contain a markdown body
        1.  This content is communication between users and agents.
        2.  Messages may communicate instructions, questions, answers, progress
            reports, decisions, results, etc.
        3.  It should be written following `4. Numbered Report Style`

### 3.1. Message root properties

1.  The top level properties in YAML frontmatter are properties of the message
    itself.
2.  Messages may have any properties set.
3.  These are the standard ones:
    1.  `created`
        1.  Required.
        2.  A datetime in `Sun 27 Sep 2006 - 16h 03m 32s` format.
        3.  The date and time must be valid (including leap years).
        4.  The English weekday name is required but not checked against the
            date, to preserve weekdays on messages backfilled with year 2006.
    2.  `author`
        1.  Required.
        2.  A `3.2. Contributor` value.
    3.  `subject`
        1.  Required.
        2.  A string of `64` characters or less.
        3.  A brief summary of the message, not the task as a whole.
        4.  This will be shown in listing to help users navigate the
            conversation history.
        5.  For a message that only changes task status, use
            `OldStatus -> NewStatus` (eg: `draft -> ready`).
    4.  `cargo`
        1.  Required.
        2.  Must be one of `3.1.1. Task`, `3.1.2. Question`, or `3.1.3. Answer`

#### 3.1.1. Task

1.  Must have `type: task`
2.  A task may have any properties set.
3.  The standard properties of tasks are as follows:
    1.  `status` is a required `3.1.1.1. Status` value
    2.  `worker` is an optional `3.2. Contributor` value

##### 3.1.1.1. Status

A `Status` value must be one of:

1.  `draft` - Still being written, not ready to begin work.
2.  `ready` - Ready to begin work.
3.  `started` - Work has begun.
4.  `blocked` - Can not be completed by the worker.
5.  `delivered` - Completed, and ready for review.
6.  `done` - Reviewed, no more work required.
7.  `cancelled` - No longer intended to be worked on.

#### 3.1.2. Question

1.  Must have `type: question`
2.  Markdown body
    1.  Must ask just one question.
    2.  If multiple questions need answering they should each be a separate
        message.

#### 3.1.3. Answer

1.  Must have `type: answer`

2.  May have `regarding`

    1.  This is a map of Truncated Task ID -\\> Task Subject.

    2.  Task ID should be truncated to 10 characters.

    3.  Task subject should 64 characters or less.

    4.  Eg:

        ``` markdown
        cargo:
          type: answer
          regarding:
            01JMQ3ZK7V: Should we pin the clock in tests?
            01JMQ4B2XD: Which fake clock library should we use?
        ```

3.  Markdown body.

    1.  Should answer to a previous question, or questions.

### 3.2. Contributor

1.  May either be a user or an agent.
2.  A user is represented by the string `user`.
3.  An agent is represented by an object with these properties:
    1.  `type`
        1.  Required.
        2.  Always `agent`.
    2.  `harness`
        1.  Optional.
        2.  Must match the regex `^[a-z0-9./-]+$`.
        3.  Eg. `pi`
    3.  `model`
        1.  Required.
        2.  Must match the regex `^[a-z0-9./-]+$`.
        3.  Eg. `claude-opus-5.5`, or `qwen/qwen3.8-max-0902`
    4.  `name`
        1.  Optional.
        2.  Used to identify agents and subagents.
        3.  Must match the regex `^[a-z0-9./-]+$`.
        4.  Eg. `coordinator`, or `researcher-01`

## 4. Numbered Report Style

1.  This file is written in Numbered Report Style.
2.  Each heading, other than the `h1`, is numbered.
3.  Paragraphs are not used.
4.  Content is primarily communicated through nested numbered lists.
5.  Each list item is short and factual.
6.  Short examples are given where appropriate.

## 5. Full example

- `tasks/`
  - `01-keyboard-keys/`
    - `01M3GJ5XDTGG51DB77PR8EJ039.md`

      ``` markdown
      ---
      created: Sun 27 Sep 2006 - 13h 23m 00s
      author: user
      subject: Keyboard keys
      cargo:
        type: task
        status: draft
      ---

      # Keyboard keys

      1. Find out what keys are on a macbook.
      ```

    - `01M3GJ5XDTS3PKTY6P4E1J7B1D.md`

      ``` markdown
      ---
      created: Sun 27 Sep 2006 - 13h 24m 00s
      author: user
      subject: draft -> ready
      cargo:
        type: task
        status: ready
      ---
      ```

    - `01M3GJ5XDTH9A69A9H6TZ1MFF6.md`

      ``` markdown
      ---
      created: Sun 27 Sep 2006 - 13h 24m 00s
      author:
        type: agent
        harness: pi
        model: kimi-k3
      subject: ready -> started
      cargo:
        type: task
        status: started
      ---
      ```

    - `01M3GJ5XDTK7ZP9R2X4V8N6Q3W.md`

      ``` markdown
      ---
      created: Sun 27 Sep 2006 - 13h 34m 00s
      author:
        type: agent
        harness: pi
        model: kimi-k3
        name: coordinator
      subject: Results
      cargo:
        type: task
        status: delivered
      ---

      # Results

      1. I have written the Macbook keys to `./output/keys.yaml`
      ```

    - `01M3GJ5XDTM4C8D1E2F3G5H7J9.md`

      ``` markdown
      ---
      created: Mon 28 Sep 2006 - 09h 12m 00s
      author: user
      subject: delivered -> done
      cargo:
        type: task
        status: done
      ---
      ```

## 6. Workflow

1.  Tasks
    1.  Both users and agents can create tasks.
    2.  Users can assign work to themselves or agents.
    3.  Agents can assign work to themselves, users, or other agents.
2.  When agents are assigned to work on tasks
    1.  They should read all messages in the task.
    2.  As they work they may periodically send progress reports.
    3.  They may ask questions, and continue working.
    4.  If they are unable to proceed they are blocked.
        1.  They should check the messages to see if any new messages have
            arrived that unblock them (eg: Answers to questions they've asked).
        2.  If they're still blocked then they should send a message that
            updates the task's status to blocked and explain why.
3.  When an agent completes a task they MUST send a message:
    1.  Updating the status of the task to `delivered`
    2.  Providing the result of task
        1.  OR if the task required making changes elsewhere, then a summary of
            the of the work done.
")

(defn run-system [{:keys [args]}]
  (if (empty? args)
    (print system-description)
    (die "td system takes no arguments.\nSee 'td system --help'.")))

;; ---------------------------------------------------------------------------
;; Entry point

(def commands
  [{:cmds []
    :doc "TaskDown command line tool"
    :epilog "Run 'td system' for the built-in TaskDown system reference."}
   {:cmds ["system"]
    :doc "Learn about the TaskDown system"
    :fn run-system
    :restrict true}
   {:cmds ["message"]
    :doc "Create and validate task messages"}
   {:cmds ["message" "new"]
    :doc "Create a new message inside an existing task"
    :fn run-new
    :spec new-option-spec
    :restrict true
    :restrict-args true
    :repeated-opts true
    :epilog new-help-epilog}
   {:cmds ["message" "validate"]
    :doc "Check message file(s) against the TaskDown spec"
    :fn run-validate
    :restrict true
    :epilog validate-help-epilog}])

(defn -main [& args]
  ;; Keep the no-argument help behavior while letting dispatch render every page.
  (let [args (cond
               (or (empty? args) (= args ["help"])) ["--help"]
               (= args ["message"]) ["message" "--help"]
               :else args)]
    (cli/dispatch commands args
                  {:prog "td"
                   :help true
                   :help-fn (fn [{:keys [tree dispatch prog inherit]}]
                              (if (= dispatch ["system"])
                                (print system-description)
                                (println (cli/format-command-help
                                          {:table tree :cmds dispatch
                                           :prog prog :inherit inherit}))))})))

(apply -main *command-line-args*)
