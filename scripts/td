#!/bin/sh
# Compatibility launcher; TaskDown is maintained in its own Babashka project.
# Preserve the caller's working directory so tasks/ still belongs to this project.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
taskdown_home=${TASKDOWN_HOME:-"$script_dir/../../../babashka/taskdown"}
if [ ! -x "$taskdown_home/td" ]; then
    printf '%s\n' "TaskDown not found at $taskdown_home. Set TASKDOWN_HOME to its checkout." >&2
    exit 1
fi
exec "$taskdown_home/td" "$@"
