#!/usr/bin/env python3
"""PTY integration tests for the Gum example's multiline body editor."""

import errno
import os
import pty
import select
import shutil
import signal
import subprocess
import tempfile
import time
from pathlib import Path

SOURCE = Path(__file__).resolve().parent


def run_flow(mode):
    with tempfile.TemporaryDirectory(prefix="gum-test-") as directory:
        root = Path(directory)
        (root / "scripts/examples").mkdir(parents=True)
        (root / "tasks/example").mkdir(parents=True)
        (root / "bin").mkdir()
        for name in ("td", "examples/message-new-gum.bb"):
            shutil.copy2(SOURCE / name, root / "scripts" / name)

        gum = root / "bin/gum"
        gum.write_text("""#!/bin/sh
case "$1" in
  filter)
    case "$*" in
      *"Task folder ("*) printf 'example\\n' ;;
      *"Type ("*) printf '%s\\n' "$GUM_TEST_TYPE" ;;
      *"Status ("*) printf 'draft\\n' ;;
      *) exit 70 ;;
    esac ;;
  input) printf 'Multiline test\\n' ;;
  confirm)
    printf 'CONFIRM_READY\\n' > /dev/tty
    IFS= read -r answer < /dev/tty
    [ "$answer" = y ] ;;
  *) echo "Unexpected Gum command: $*" >&2; exit 70 ;;
esac
""")
        gum.chmod(0o755)
        env = os.environ.copy()
        env.update(PATH=f"{root / 'bin'}:{env['PATH']}", TERM="xterm-256color",
                   NO_COLOR="1", GUM_TEST_TYPE="question" if mode == "question" else "task")

        pid, master = pty.fork()
        if pid == 0:
            os.chdir(root)
            os.execve(str(root / "scripts/examples/message-new-gum.bb"),
                      [str(root / "scripts/examples/message-new-gum.bb")], env)

        output = b""
        deadline = time.monotonic() + 30
        child = 0

        def read_more():
            nonlocal output
            if time.monotonic() > deadline:
                raise AssertionError(f"Gum example timed out: {output[-2000:]!r}")
            ready, _, _ = select.select([master], [], [], 0.2)
            if ready:
                try:
                    output += os.read(master, 65536)
                except OSError as error:
                    if error.errno != errno.EIO:  # PTY closed by child
                        raise

        def wait_for(text):
            needle = text.encode()
            while needle not in output:
                read_more()

        try:
            wait_for("Ctrl-C: cancel")
            # JLine probes terminal capabilities before entering its input loop.
            time.sleep(0.3)
            files = lambda: list((root / "tasks/example").glob("*.md"))
            if mode in ("cancel", "eof"):
                os.write(master, b"\x03" if mode == "cancel" else b"\x04")
            else:
                if mode == "question":
                    os.write(master, b"Missing mark\x19")
                    wait_for("A question body must contain exactly one question mark.")
                    wait_for("Ctrl-C: cancel")
                    os.write(master, b"Why?\rBecause")
                elif mode == "empty":
                    pass
                else:
                    os.write(master, b"First line\r")
                    time.sleep(0.2)
                    assert os.waitpid(pid, os.WNOHANG)[0] == 0, output[-2000:]
                    assert not files(), files()
                    os.write(master, b"Second line")
                if mode != "empty":
                    time.sleep(0.2)
                    assert os.waitpid(pid, os.WNOHANG)[0] == 0, output[-2000:]
                    assert not files(), files()
                os.write(master, b"\x19")  # Ctrl-Y submits the body
                wait_for("CONFIRM_READY")
                assert not files(), files()
                if mode == "empty":
                    assert b"(empty)" in output, output[-2000:]
                elif mode == "question":
                    assert "│ Why?".encode() in output, output[-2000:]
                    assert "│ Because".encode() in output, output[-2000:]
                else:
                    assert "│ First line".encode() in output, output[-2000:]
                    assert "│ Second line".encode() in output, output[-2000:]
                os.write(master, b"n\r" if mode == "decline" else b"y\r")

            while True:
                child, status = os.waitpid(pid, os.WNOHANG)
                if child:
                    break
                read_more()
            assert os.waitstatus_to_exitcode(status) == 0, output[-2000:]
            if mode in ("cancel", "eof", "decline"):
                assert not files(), files()
                assert b"Cancelled." in output, output[-2000:]
            else:
                assert len(files()) == 1, files()
                content = files()[0].read_text()
                if mode == "question":
                    assert "Why?\nBecause\n" in content, content
                elif mode == "empty":
                    assert content.endswith("---\n"), content
                else:
                    assert "First line\nSecond line\n" in content, content
                assert subprocess.run(["./scripts/td", "message", "validate"], cwd=root,
                                      stdout=subprocess.DEVNULL, check=False).returncode == 0
        finally:
            if not child:
                try:
                    os.kill(pid, signal.SIGKILL)
                    os.waitpid(pid, 0)
                except ProcessLookupError:
                    pass
            os.close(master)


for mode in ("task", "question", "empty", "decline", "cancel", "eof"):
    run_flow(mode)
print("gum multiline body tests passed")
