#include <behaviors.dtsi>
#include <behaviors/braille.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    behaviors {
        bc_other: another_braille_dot {
            compatible = "zmk,behavior-braille-dot";
            #binding-cells = <1>;
        };
    };
    keymap {
        compatible = "zmk,keymap";
        base {
            bindings = <
                &bc 7 &bc 3 &bc 2 &bc 1 &bc 4 &bc 5 &bc 6 &bc 8
                &bspc &kp SPACE &kp A &to 1 &to 2 &bc 2 &kp B &none
            >;
        };
        another {
            bindings = <
                &bc_other 8 &bc_other 7 &bc_other 6 &bc_other 5 &bc 4 &bc 3 &bc 2 &bc 1
                &kp SPACE &kp C &bspc &to 0 &to 2 &trans &bc 2 &none
            >;
        };
        transparent {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &to 0 &to 1 &trans &trans &none
            >;
        };
    };
};

#define TAP(row, col) ZMK_MOCK_PRESS(row, col, 10) ZMK_MOCK_RELEASE(row, col, 10)

&kscan {
    columns = <8>;
    events = <
        /* Every dot on BASE, Braille space, and ordinary Space/A. */
        TAP(0, 0) TAP(0, 1) TAP(0, 2) TAP(0, 3)
        TAP(0, 4) TAP(0, 5) TAP(0, 6) TAP(0, 7)
        TAP(1, 0) TAP(1, 1) TAP(1, 2)
        /* Conventional typing still passes through while a dot is held. */
        ZMK_MOCK_PRESS(0, 3, 10) TAP(1, 1) TAP(1, 2) ZMK_MOCK_RELEASE(0, 3, 10)
        /* Dot 1 release must not become layer 1's dot 5. */
        ZMK_MOCK_PRESS(0, 3, 10) TAP(1, 3) ZMK_MOCK_RELEASE(0, 3, 10)
        /* All dots on another layer, at different positions/instances. */
        TAP(0, 0) TAP(0, 1) TAP(0, 2) TAP(0, 3)
        TAP(0, 4) TAP(0, 5) TAP(0, 6) TAP(0, 7)
        /* Braille space release must not become conventional A. */
        ZMK_MOCK_PRESS(1, 2, 10) TAP(1, 3) ZMK_MOCK_RELEASE(1, 2, 10)
        /* Braille space release must not become conventional Space. */
        ZMK_MOCK_PRESS(1, 0, 10) TAP(1, 3) ZMK_MOCK_RELEASE(1, 0, 10)
        /* Conventional Space release must not join the Braille chord. */
        ZMK_MOCK_PRESS(1, 0, 10) TAP(1, 3) ZMK_MOCK_RELEASE(1, 0, 10)
        /* Conventional Space keeps its original usage, not layer 1's C. */
        ZMK_MOCK_PRESS(1, 1, 10) TAP(1, 3) ZMK_MOCK_RELEASE(1, 1, 10)
        /* Custom-instance dot 8 release must not become BASE's dot 7. */
        ZMK_MOCK_PRESS(0, 0, 10) TAP(1, 4) ZMK_MOCK_RELEASE(0, 0, 10)
        /* Transparent layers find the actual lower-layer Braille binding. */
        TAP(1, 5)
        TAP(1, 3) TAP(1, 6)
        /* Overlap, early release, late join, re-press, and space+dot capture. */
        ZMK_MOCK_PRESS(0, 3, 10) ZMK_MOCK_PRESS(0, 2, 10)
        ZMK_MOCK_RELEASE(0, 3, 10) ZMK_MOCK_PRESS(0, 1, 10)
        ZMK_MOCK_PRESS(0, 3, 10) ZMK_MOCK_RELEASE(0, 2, 10)
        ZMK_MOCK_RELEASE(0, 1, 10) ZMK_MOCK_PRESS(1, 0, 10)
        ZMK_MOCK_RELEASE(0, 3, 10) ZMK_MOCK_RELEASE(1, 0, 10)
        /* Two physical bindings for dot 2 must both release. */
        ZMK_MOCK_PRESS(0, 2, 10) ZMK_MOCK_PRESS(1, 5, 10)
        ZMK_MOCK_RELEASE(0, 2, 10) ZMK_MOCK_RELEASE(1, 5, 10)
        /* Chord survives a layer switch; newly reached bindings may join it. */
        ZMK_MOCK_PRESS(0, 3, 10) TAP(1, 3) ZMK_MOCK_PRESS(0, 0, 10)
        ZMK_MOCK_RELEASE(0, 3, 10) ZMK_MOCK_PRESS(1, 2, 10)
        ZMK_MOCK_RELEASE(0, 0, 10) ZMK_MOCK_RELEASE(1, 2, 10)
        TAP(1, 3)
    >;
};
